# Public — safe to expose to the browser. Shared with the mobile app.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Development sign-in bypass. Renders a "Skip sign-in (dev)" link on the login
# screen that fabricates an admin session without contacting Supabase, so the
# panel can be worked on with no backend attached.
#
# Ignored entirely in production builds — NODE_ENV is checked independently of
# this flag, so setting it true in a deployed environment does nothing.
NEXT_PUBLIC_ENABLE_DEV_LOGIN=false
